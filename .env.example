# Public, build-time settings for Vercel (or any static host).
# Do not put secrets in VITE_* variables — they are compiled into the client bundle.

# Optional POST endpoint that receives submitted order requests as JSON.
# Leave empty to keep the checkout in its clearly labelled "not connected" mode.
# Changing this requires a new deployment because Vite inlines it at build time.
VITE_ORDER_ENDPOINT=
